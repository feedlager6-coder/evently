# Evently Environment Configuration Example

# Application
APP_NAME=Evently
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database (SQLite with WAL mode for local MVP)
DATABASE_URL=sqlite+aiosqlite:///./evently.db

# Telegram Bot Credentials (obtain from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ_example
TELEGRAM_BOT_USERNAME=evently_bot
TELEGRAM_MINI_APP_URL=https://t.me/evently_bot/app

# Admin Telegram User IDs (comma-separated integer IDs)
ADMIN_USER_IDS=123456789,987654321

# Security
SECRET_KEY=evently_mvp_secret_key_change_in_production_32bytes
AUTH_DATE_MAX_AGE_SECONDS=86400

# TypeSafe AI (Optional Secondary Validation Layer)
TYPESAFE_API_KEY=
TYPESAFE_ENABLED=false
