# Evently Environment Configuration Example
# Copy to .env and adjust variables for your environment.

# ==========================================
# 1. Application & Server Configuration
# ==========================================
APP_NAME=Ivently
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Public domain/hostname of the deployed application (without https://)
# On Railway, this is your generated service domain (e.g. ivently.up.railway.app)
PUBLIC_HOST=

# Allowed CORS Origins (comma-separated, default '*' for Telegram Mini App webviews)
CORS_ORIGINS=*

# ==========================================
# 2. Database Configuration
# ==========================================
# Local development default: SQLite with WAL mode
DATABASE_URL=sqlite+aiosqlite:///./evently.db

# Production (Railway PostgreSQL):
# Railway automatically populates DATABASE_URL when PostgreSQL service is linked.
# Supports postgres://, postgresql://, or postgresql+asyncpg://
# DATABASE_URL=postgresql+asyncpg://postgres:password@postgres.railway.internal:5432/railway

# ==========================================
# 3. Telegram Bot & Mini App Credentials
# ==========================================
# Obtain from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ_example
TELEGRAM_BOT_USERNAME=Ivently_bot

# Direct link to the Telegram Mini App (configured via @BotFather /newapp with short name 'app')
# Format: https://t.me/<TELEGRAM_BOT_USERNAME>/<SHORT_NAME>
TELEGRAM_MINI_APP_URL=https://t.me/Ivently_bot/app


# Admin Telegram User IDs permitted to access /admin and moderation queue (comma-separated)
ADMIN_USER_IDS=123456789,987654321

# ==========================================
# 4. Security
# ==========================================
SECRET_KEY=evently_mvp_secret_key_change_in_production_32bytes
AUTH_DATE_MAX_AGE_SECONDS=86400

# ==========================================
# 5. TypeSafe AI (Optional Secondary Layer)
# ==========================================
# Evently runs 100% autonomously without this key.
TYPESAFE_API_KEY=
TYPESAFE_ENABLED=false
