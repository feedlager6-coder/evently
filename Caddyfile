:80 {
    encode gzip zstd

    handle_path /uploads/* {
        root * /var/www/uploads
        file_server
        header Cache-Control "public, max-age=2592000, immutable"
    }

    handle {
        reverse_proxy app:8000 {
            header_up X-Forwarded-Proto http
            header_up X-Forwarded-Host {host}
        }
    }
}

:443 {
    tls internal
    encode gzip zstd

    handle_path /uploads/* {
        root * /var/www/uploads
        file_server
        header Cache-Control "public, max-age=2592000, immutable"
    }

    handle {
        reverse_proxy app:8000 {
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host {host}
        }
    }
}
